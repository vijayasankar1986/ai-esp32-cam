// Copy to secrets.h and fill in your own values.
// secrets.h is gitignored. Never commit Wi-Fi credentials to a public repository.
#pragma once

#define WIFI_SSID     "YourNetwork"
#define WIFI_PASSWORD "YourPassword"

// Optional fixed address so the controller's IP never moves and the Pi's
// control_host in poc.yaml doesn't have to be re-read after every reboot.
// Leave HOST_IP empty to use DHCP, then read the address this firmware
// prints over USB serial at boot.
#define HOST_IP       ""
#define GATEWAY_IP    "192.168.1.1"
#define SUBNET_MASK   "255.255.255.0"
