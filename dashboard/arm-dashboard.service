[Unit]
Description=Robotic arm project status dashboard
# network-online, not network.target: the latter fires before the network is
# usable, and a DDS node that starts then completes only partial discovery. It
# sees publisher counts but never receives messages, so the dashboard shows a
# connected node with zero frames until it is restarted by hand.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bbt
WorkingDirectory=/home/bbt/ai-esp32cam
# Manual jog from the dashboard. This server has no authentication and binds
# every interface, so with this set anyone who can reach port 8080 can move the
# arm. The node must ALSO run with allow_manual:=true before anything moves.
# Comment this line out to make the dashboard observe-only again.
Environment=ARM_DASHBOARD_CONTROL=1
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash /home/bbt/ai-esp32cam/dashboard/start.sh
# Kill only the server, not its whole control group. The restart button spawns
# the arm_poc node as a child of this service, and setsid does not escape a
# systemd cgroup, so the default control-group kill took the node down with
# every dashboard restart: the node vanished with ExternalShutdownException and
# the dashboard came back showing a connected system with no data.
KillMode=process
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
# No PrivateTmp: Fast DDS uses shared memory for same-host transport and needs
# the same /tmp and /dev/shm namespace as the node. With an isolated /tmp the
# observer discovered the publisher over UDP but never received a message, so
# the dashboard reported a connected node publishing nothing.

[Install]
WantedBy=multi-user.target
