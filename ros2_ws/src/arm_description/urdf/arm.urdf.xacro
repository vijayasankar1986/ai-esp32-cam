<?xml version="1.0"?>
<!--
  Kinematic model of the four-servo arm.

  GEOMETRY IS UNVERIFIED. Every dimension below is a typical value for the
  KitKraft 3D-printed SG90 kit, not a measurement of this build; docs/HARDWARE.md
  records no link lengths. Planned poses will not match the real arm until the
  four properties in the block below are replaced with measured values. Nothing
  else in the stack needs to change when they are.

  Joint sign convention: zero is the neutral pose the firmware homes to, which
  the servos see as 90 degrees. The +/- 90 degree offset between this model and
  the servo scale lives in exactly one place, arm_moveit_bridge, so the URDF
  stays in ordinary MoveIt units (radians, zero-centred).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm">

  <!-- ==== MEASURE THESE FOUR (metres) ================================== -->
  <xacro:property name="base_height" value="0.055"/>  <!-- UNVERIFIED: table to shoulder pivot -->
  <xacro:property name="upper_arm"   value="0.085"/>  <!-- UNVERIFIED: shoulder to elbow pivot -->
  <xacro:property name="forearm"     value="0.080"/>  <!-- UNVERIFIED: elbow to wrist pivot -->
  <xacro:property name="gripper_len" value="0.055"/>  <!-- UNVERIFIED: wrist to gripper tip -->
  <!-- =================================================================== -->

  <xacro:property name="limb_w" value="0.022"/>
  <xacro:property name="pi_2"   value="1.5707963"/>

  <!-- SG90-class servos and printed links: masses are nominal. Nothing in the
       plan-and-execute path uses dynamics, but a URDF without inertia makes
       several tools complain. -->
  <xacro:macro name="chunk" params="mass">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </xacro:macro>

  <material name="steel"><color rgba="0.62 0.67 0.72 1"/></material>
  <material name="mint"><color rgba="0.20 0.78 0.60 1"/></material>

  <!-- Ground plate. Fixed frame the planner treats as the world. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.006"/>
      <geometry><box size="0.10 0.10 0.012"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.006"/>
      <geometry><box size="0.10 0.10 0.012"/></geometry>
    </collision>
    <xacro:chunk mass="0.20"/>
  </link>

  <!-- joint0 — base rotation, GPIO 27 (D27) -->
  <joint name="joint0" type="revolute">
    <parent link="base_link"/>
    <child link="base_rotor"/>
    <origin xyz="0 0 0.012"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${pi_2}" upper="${pi_2}" effort="1.5" velocity="0.6"/>
  </joint>

  <link name="base_rotor">
    <visual>
      <origin xyz="0 0 ${base_height/2}"/>
      <geometry><cylinder radius="0.020" length="${base_height}"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}"/>
      <geometry><cylinder radius="0.020" length="${base_height}"/></geometry>
    </collision>
    <xacro:chunk mass="0.08"/>
  </link>

  <!-- joint1 — shoulder, GPIO 26 (D26). Zero points the upper arm straight up. -->
  <joint name="joint1" type="revolute">
    <parent link="base_rotor"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 ${base_height}"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${pi_2}" upper="${pi_2}" effort="1.5" velocity="0.6"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 ${upper_arm/2}"/>
      <geometry><box size="${limb_w} ${limb_w} ${upper_arm}"/></geometry>
      <material name="mint"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${upper_arm/2}"/>
      <geometry><box size="${limb_w} ${limb_w} ${upper_arm}"/></geometry>
    </collision>
    <xacro:chunk mass="0.06"/>
  </link>

  <!-- joint2 — elbow, GPIO 25 (D25) -->
  <joint name="joint2" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 ${upper_arm}"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${pi_2}" upper="${pi_2}" effort="1.5" velocity="0.6"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 ${forearm/2}"/>
      <geometry><box size="${limb_w} ${limb_w} ${forearm}"/></geometry>
      <material name="mint"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${forearm/2}"/>
      <geometry><box size="${limb_w} ${limb_w} ${forearm}"/></geometry>
    </collision>
    <xacro:chunk mass="0.05"/>
  </link>

  <!-- Wrist plate: fixed. This build has no wrist servo; GPIO 33 drives the
       gripper jaws, which is why the arm group below is three joints. -->
  <link name="wrist_link">
    <visual>
      <geometry><box size="${limb_w} ${limb_w} 0.010"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <geometry><box size="${limb_w} ${limb_w} 0.010"/></geometry>
    </collision>
    <xacro:chunk mass="0.02"/>
  </link>

  <joint name="wrist_fixed" type="fixed">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 ${forearm}"/>
  </joint>

  <!-- joint3 — gripper, GPIO 33 (D33). One driven jaw; the mimic jaw is
       visual only, so it stays out of the planning group. -->
  <joint name="joint3" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_jaw"/>
    <origin xyz="0 0 0.005"/>
    <axis xyz="0 1 0"/>
    <limit lower="-${pi_2}" upper="${pi_2}" effort="1.0" velocity="0.6"/>
  </joint>

  <link name="gripper_jaw">
    <visual>
      <origin xyz="0 0 ${gripper_len/2}"/>
      <geometry><box size="0.008 ${limb_w} ${gripper_len}"/></geometry>
      <material name="mint"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${gripper_len/2}"/>
      <geometry><box size="0.008 ${limb_w} ${gripper_len}"/></geometry>
    </collision>
    <xacro:chunk mass="0.02"/>
  </link>

  <!-- Planning target. Pose goals are given for this frame. -->
  <link name="tool0"/>
  <joint name="tool0_fixed" type="fixed">
    <parent link="wrist_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 ${gripper_len}"/>
  </joint>

</robot>
