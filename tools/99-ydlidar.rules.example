# Copy to /etc/udev/rules.d/99-ydlidar.rules and fill in the KERNELS port path.
#
# Confirmed 2026-09-24: the X2's bundled adapter and the arm controller's
# board are both CP2102 (10c4:ea60) with the *same* unprogrammed serial
# "0001", so vendor/product/serial cannot tell them apart when both are
# plugged in at once. Keying on the physical USB port instead, which is
# stable as long as the LiDAR stays in that port:
#     udevadm info -q path -n /dev/ttyUSBx
# gives a path ending in .../usb1/1-1/1-1.4/1-1.4:1.0/ttyUSB0/...; the
# "1-1.4" segment is the KERNELS value below. Re-run this after moving the
# LiDAR to a different physical port.
# Reload with: sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="tty", KERNELS=="FILL_IN_PORT_E.G._1-1.4", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ydlidar", MODE="0666", GROUP="dialout"
