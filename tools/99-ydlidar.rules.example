# Copy to /etc/udev/rules.d/99-ydlidar.rules and fill in ATTRS{serial}.
#
# The X2's bundled adapter uses the same CP2102 chip (10c4:ea60) as the arm
# controller's board, so matching on vendor/product alone would symlink
# whichever of the two enumerates first. Find the LiDAR's own serial after
# plugging it in with:
#     udevadm info -a -n /dev/ttyUSBx | grep '{serial}' | head -1
# then reload with: sudo udevadm control --reload-rules && sudo udevadm trigger

SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="FILL_IN_AFTER_PLUGGING_IN", SYMLINK+="ydlidar", MODE="0666", GROUP="dialout"
